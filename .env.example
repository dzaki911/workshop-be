# Aplikasi
# development = rute admin memakai admin uji (DEV_ADMIN_EMAIL). Di luar development rute admin
# ditolak 401 sampai auth/middleware sesi 3 selesai.
APP_ENV=development
APP_PORT=8080

# Admin uji (dibuat oleh `go run ./cmd/seed`) - hanya untuk lokal
DEV_ADMIN_EMAIL=admin@raport.local
# Password akun seed (opsional, default: Password123!) - hanya untuk lokal
SEED_PASSWORD=Password123!

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=raport_evaluasi
DB_SSLMODE=disable

# Auth (JWT) - dipakai pada sesi 3
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_HOURS=24
